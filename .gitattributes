# Auto detect text files and perform LF normalization
* text=auto

# Force specific files to always have LF line endings
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.so binary
*.egg binary
*.pkl binary
*.h5 binary
*.onnx binary
*.pt binary